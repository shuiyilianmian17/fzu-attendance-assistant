<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F2F5FA">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Navy" Color="#17365F"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#183452"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#78899F"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E8F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Foreground" Value="#17365F"/></Style>
  <Style TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="18,0"/><Setter Property="Background" Value="#F2F6FC"/><Setter Property="Foreground" Value="#23466F"/><Setter Property="BorderBrush" Value="#DAE4F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#17365F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#17365F"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#60748E"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Item" Padding="16,14" CornerRadius="10" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Item" Property="Background" Value="#17365F"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="False"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Item" Property="Background" Value="#EEF3FA"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="26"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Border x:Name="Track" Background="#D3DFEE" CornerRadius="13"/><Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#17365F"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#5F91D0"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#F8FAFD"/><Setter Property="Foreground" Value="#23466F"/><Setter Property="BorderBrush" Value="#DAE4F1"/><Setter Property="Padding" Value="12,9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#B5CDEC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#416FA8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="50"/><Setter Property="FontSize" Value="24"/><Setter Property="Foreground" Value="#17365F"/><Setter Property="Background" Value="#F6F9FD"/><Setter Property="BorderBrush" Value="#DAE4F1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#F6F9FD" BorderBrush="#DAE4F1" BorderThickness="1" CornerRadius="10"><Path Data="M0 0 L4 4 L8 0" Stroke="#6E849E" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" Margin="15,0,30,0"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="White" BorderBrush="#DAE4F1" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,4,0,0" MinWidth="100" MaxHeight="240"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="16"/></Style>
 </UserControl.Resources>
 <Grid Margin="20">
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border CornerRadius="18" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" Padding="16,22">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,28"><Image x:Name="BrandIcon" Width="50" Height="50" HorizontalAlignment="Left" Margin="8,0,0,12"/><TextBlock Text="晚点名助手" FontWeight="Bold" FontSize="20" Margin="8,0,0,5"/><TextBlock Text="把签到交给后台" Style="{StaticResource Muted}" Margin="8,0,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><RadioButton x:Name="NavOverview" GroupName="Navigation" Content="签到概览" IsChecked="True"/><RadioButton x:Name="NavSchedule" GroupName="Navigation" Content="签到设置"/><RadioButton x:Name="NavEnvironment" GroupName="Navigation" Content="运行环境"/><RadioButton x:Name="NavLogs" GroupName="Navigation" Content="运行记录"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid><StackPanel VerticalAlignment="Top" Margin="2,2,150,0"><TextBlock x:Name="PageTitle" Text="签到概览" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="今天的签到安排与运行状态" Style="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E4EDF9" CornerRadius="18" Padding="14,9" Margin="0,9,0,0"><TextBlock x:Name="RunBadge" Text="自动签到已开启" FontSize="12" FontWeight="SemiBold"/></Border></Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="每日签到时间" Style="{StaticResource Muted}"/><TextBlock x:Name="PlanValue" Text="21:05" FontSize="32" FontWeight="Bold" Margin="0,10,0,7"/><TextBlock Text="每天 · 北京时间" Style="{StaticResource Muted}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="今日签到" Style="{StaticResource Muted}"/><TextBlock x:Name="TodayValue" Text="待签到" FontSize="27" FontWeight="SemiBold" Margin="0,14,0,9"/><TextBlock Text="以页面确认结果为准" Style="{StaticResource Muted}"/></StackPanel></Border>
      <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="运行方式" Style="{StaticResource Muted}"/><TextBlock Text="后台运行" FontSize="27" FontWeight="SemiBold" Margin="0,14,0,9"/><TextBlock Text="不占用当前桌面" Style="{StaticResource Muted}"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><DockPanel><TextBlock Text="当前状态" Style="{StaticResource Section}"/><TextBlock x:Name="DateText" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></DockPanel><TextBlock x:Name="StateText" Text="正在读取运行状态…" FontSize="15" LineHeight="24" MinHeight="45" Margin="0,7,0,16"/><Border Background="#F3F7FD" Padding="14,10" CornerRadius="9" Margin="0,0,0,20"><TextBlock x:Name="NextRun" Text="下次计划：今天 21:05" FontSize="13"/></Border><WrapPanel><Button x:Name="CheckConnection" Content="检查连接" Style="{StaticResource Primary}" Margin="0,0,12,10"/><Button x:Name="AttemptNow" Content="立即尝试签到" Margin="0,0,12,10"/><Button x:Name="ShowHiddenPage" Content="显示隐藏页" Margin="0,0,12,10"/><Button x:Name="RestartClient" Content="重启安卓应用" ToolTip="重启模拟器内的智汇福大，并重新进入晚点名。" Margin="0,0,12,10"/><Button x:Name="RefreshLocation" Content="重新定位" Margin="0,0,12,10"/><Button x:Name="CheckUpdate" Content="检查更新" ToolTip="从 GitHub 获取最新版安装包，校验后更新并重新打开助手。" Margin="0,0,12,10"/><Button x:Name="ExportDiagnostics" Content="导出诊断" Margin="0,0,0,10"/></WrapPanel><Border BorderBrush="#EDF1F6" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,6,0,0"><StackPanel><TextBlock Text="手动操作" FontWeight="SemiBold" Margin="0,0,0,10"/><WrapPanel><Button x:Name="OpenEmulator" Content="打开模拟器窗口" ToolTip="打开所选实例，供手动登录或操作；期间暂缓自动签到。" Margin="0,0,12,8"/><Button x:Name="CloseEmulator" Content="关闭模拟器" ToolTip="关闭所选实例；下次设定时间再启动，手动检查可提前恢复。" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button x:Name="GoLogs" DockPanel.Dock="Right" Content="查看全部" Height="30" Padding="12,0" FontSize="12"/><TextBlock Text="最近记录" Style="{StaticResource Section}"/></DockPanel><TextBlock x:Name="RecentLogs" Text="暂无运行记录" FontSize="12" Foreground="#71839A" LineHeight="22" Margin="0,7,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SchedulePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="每日签到" Style="{StaticResource Section}"/><TextBlock Text="设定时间后自动签到，确认成功后自动关闭模拟器。" Style="{StaticResource Muted}"/><Grid Margin="0,24,0,22"><StackPanel Margin="0,0,70,0"><TextBlock Text="启用自动签到" FontWeight="SemiBold"/><TextBlock Text="暂停后，不会自动提交签到。" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="EnabledToggle" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="启用自动签到"/></Grid><Border BorderBrush="#EDF1F6" BorderThickness="0,1,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="每天执行时间" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="HourPicker" Width="104"/><TextBlock Text=":" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/><ComboBox x:Name="MinutePicker" Width="104"/><TextBlock Text="北京时间" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel><TextBlock Text="学校允许签到的时段：21:00–23:59" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border><Grid Margin="0,25,0,0"><StackPanel Margin="0,0,70,0"><TextBlock Text="登录 Windows 后自动运行" FontWeight="SemiBold"/><TextBlock Text="仅在托盘启动，不弹出设置窗口。" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="StartupToggle" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="登录 Windows 后自动运行"/></Grid><Button x:Name="SaveSchedule" Content="保存签到设置" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,26,0,0"/></StackPanel></Border>
     <Border Background="#E9F0FA" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="错过时间，也会尝试补签" FontWeight="SemiBold"/><TextBlock Text="如果启动或从睡眠中恢复时仍在签到时段，助手会立即检查并尝试补签。只有页面确认成功，才会记录为已签到。" Foreground="#667F9D" FontSize="12" LineHeight="22" Margin="0,8,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="EnvironmentPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><DockPanel><TextBlock Text="MuMu 模拟器（兼容雷电）" Style="{StaticResource Section}"/><TextBlock x:Name="EnvironmentStatus" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#247C68" FontSize="12"/></DockPanel>
      <TextBlock Text="优先自动查找 MuMu，兼容雷电。选择对应控制程序，签到时自动重新发送保存的位置。" Style="{StaticResource Muted}" Margin="0,0,0,20"/>
      <TextBlock Text="模拟器控制程序" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="EmulatorPath" MinHeight="44" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="BrowseEmulator" Content="选择模拟器" Margin="0,0,12,0"/><Button x:Name="DetectEmulator" Content="自动查找"/></StackPanel>
      <DockPanel Margin="0,20,0,0"><TextBlock Text="模拟器编号" VerticalAlignment="Center"/><TextBox x:Name="EmulatorIndex" Width="72" HorizontalAlignment="Left" Margin="20,0,0,0"/></DockPanel>
      <TextBlock Text="编号与 MuMu 多开器对应，第一个通常为 0。进入晚点名后，会自动重新发送助手保存的位置。" Style="{StaticResource Muted}" LineHeight="22" Margin="0,12,0,0"/>
      <TextBlock Text="固定签到位置" FontWeight="SemiBold" Margin="0,20,0,10"/><WrapPanel><TextBlock Text="经度" VerticalAlignment="Center"/><TextBox x:Name="FixedLongitude" Width="150" Margin="10,0,20,0"/><TextBlock Text="纬度" VerticalAlignment="Center"/><TextBox x:Name="FixedLatitude" Width="150" Margin="10,0,0,0"/></WrapPanel><Button x:Name="ReadPosition" Content="读取模拟器默认位置" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock Text="核对为你的实际位置后保存。助手单独记住此位置，每次签到重新发送，不会随 MuMu 默认位置变化。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <Button x:Name="SaveEnvironment" Content="保存运行环境" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="首次配置" Style="{StaticResource Section}"/><TextBlock Text="1  在 MuMu 中安装并登录安卓版智汇福大。&#10;2  将晚点名签到添加到“我的服务”。&#10;3  在 MuMu 定位工具中确认实际位置并保存默认定位。&#10;4  在助手读取默认位置，核对经纬度后保存运行环境。" Foreground="#657E99" FontSize="13" LineHeight="27"/><Button x:Name="LoginHelp" Content="查看重新登录步骤" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><DockPanel><Button x:Name="RefreshLogs" DockPanel.Dock="Right" Content="刷新记录"/><StackPanel><TextBlock Text="运行记录" FontWeight="SemiBold"/><TextBlock Text="查看连接、签到尝试和页面确认结果。" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></DockPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><TextBox x:Name="LogsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Microsoft YaHei UI" FontSize="12" Background="White" BorderThickness="0" Padding="14"/></Border></Grid>
   </Grid>
   <TextBlock x:Name="Feedback" Grid.Row="2" Text="设置会保存在本机，签到过程在后台进行。" Foreground="#78899F" FontSize="11" VerticalAlignment="Bottom" Margin="2,0"/>
  </Grid>
 </Grid>
</UserControl>

